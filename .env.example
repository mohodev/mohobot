# MohoBot environment overrides. Copy to .env and fill in.
# Secrets NEVER go into config/*.yaml - only here.

# Discord bot token for the bot with id "main"
DISCORD_TOKEN=

# Per-bot override form: MOHO_BOT_<BOTID>_DISCORD_TOKEN
# MOHO_BOT_MAIN_DISCORD_TOKEN=

# AI provider (OpenAI compatible) - default provider
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Kilo AI gateway plugin (plugins/kilo-provider)
# Select with ai.provider: kilo in config/bots/<id>.yaml
KILO_API_KEY=

# Web search plugin (plugins/web-search). SearXNG needs no key; Brave/Tavily
# are selected via the plugin's config (provider + apiKeyEnv) in plugin.json.
BRAVE_API_KEY=
TAVILY_API_KEY=

# NVIDIA NIM（规范名称；旧 NVIDIA_API_KEY 仍兼容）
NVIDIA_NIM_API_KEY=

# 管理控制台（setup 会自动生成 Token 到 .env.local）
MOHO_ADMIN_TOKEN=
MOHO_ADMIN_HOST=127.0.0.1
MOHO_ADMIN_PORT=3210
MOHO_STORAGE_PATH=./data/mohobot.db

# Runtime
LOG_LEVEL=info
MOHO_ADAPTER=discord   # discord | console (console = headless local test)
